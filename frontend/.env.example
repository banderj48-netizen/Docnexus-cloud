# 前端本地开发配置示例
# 复制为 .env.local 后按本机环境修改，真实 .env.local 不上传 GitHub。

# Vite 代理到 Gateway 的地址。
# frp 穿透时仍保持指向本机 Gateway，外部浏览器请求 /api 后由 Vite 转发到这里。
VITE_API_TARGET=http://127.0.0.1:8088

# Vite 开发服务监听配置。
# 0.0.0.0 允许 frp 客户端和局域网访问本机前端端口；如只允许本机访问，可改回 127.0.0.1。
VITE_DEV_HOST=0.0.0.0
VITE_DEV_PORT=5173

# 正式前端默认走真实后端。只有需要纯静态演示时才改为 true。
VITE_STATIC_DEMO=false
