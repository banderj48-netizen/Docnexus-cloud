# Python AI 服务本地开发配置示例。
# 复制为 .env 后按实际环境修改，真实 .env、模型 API Key 和内部 token 禁止上传 GitHub。

SERVICE_NAME=docnexus-ai-service
SERVER_HOST=0.0.0.0
SERVER_PORT=8105
# SERVICE_IP 留空时自动探测；联调/部署时建议填写网关可访问的真实 IP。
SERVICE_IP=

APP_ENV=local
APP_TITLE=文枢智能 DocNexus AI 服务
APP_VERSION=0.1.0

NACOS_ENABLED=true
NACOS_SERVER_ADDR=127.0.0.1:8848
NACOS_GROUP=DEFAULT_GROUP
NACOS_NAMESPACE=
NACOS_USERNAME=nacos
NACOS_PASSWORD=change-me
NACOS_CLUSTER_NAME=DEFAULT
NACOS_WEIGHT=1.0

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_SSL=false

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=docnexus_cloud
MYSQL_USERNAME=root
MYSQL_PASSWORD=change-me
MYSQL_URL=mysql+pymysql://root:change-me@127.0.0.1:3306/docnexus_cloud?charset=utf8mb4

ROCKETMQ_NAMESRV_ADDR=127.0.0.1:9876
ROCKETMQ_PRODUCER_GROUP=docnexus-ai-producer-group
ROCKETMQ_CONSUMER_GROUP=docnexus-ai-consumer-group
ROCKETMQ_TOPIC_PREFIX=docnexus

MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_BUCKET=docnexus
MINIO_ACCESS_KEY=docnexus
MINIO_SECRET_KEY=change-me
MINIO_SECURE=false
