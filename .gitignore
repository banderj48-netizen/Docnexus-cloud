# ==============================
# DocNexus Cloud 项目忽略规则
# ==============================

# 只上传根目录 ReadMe.md，其它设计文档和 PDF 默认只保留本地
*.md
!/ReadMe.md
*.pdf

# Java / Maven 编译产物
target/
**/target/
*.class
*.jar
*.war
*.ear

# 前端依赖、缓存和构建产物
node_modules/
**/node_modules/
dist/
**/dist/
.vite/
**/.vite/
.npm-cache/
**/.npm-cache/

# Python 运行和缓存产物
__pycache__/
**/__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.venv/
venv/

# IDE 和本地工作区文件
.idea/
*.iml
.vscode/

# 真实配置文件不上 GitHub，只上传 application.example.* 示例
**/src/main/resources/application.yml
**/src/main/resources/application.yaml
**/src/main/resources/application.properties
!**/src/main/resources/application.example.yml
!**/src/main/resources/application.example.yaml
!**/src/main/resources/application.example.properties

# 密钥、证书和本地敏感文件
*.p12
*.jks
*.pem
*.key
*.cer
*.crt
.env
.env.*
!.env.example
runtime/

# 日志和临时文件
logs/
*.log
*.tmp
*.bak
*.swp
